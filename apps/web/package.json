{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.14.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "prebuild": "pnpm run lint && pnpm run typecheck",
    "format": "prettier --write .",
    "db:bootstrap": "tsx scripts/bootstrap-db.ts",
    "db:types": "kysely-codegen --dialect postgres --env-file .env.local --out-file src/db/generated.ts",
    "db:types:check": "tsx scripts/check-generated-types.ts",
    "catalog:sources:import-sample": "tsx scripts/import-catalog-source-sample.ts",
    "catalog:sources:import-ua-register-variety": "tsx scripts/import-ua-state-register-variety.ts",
    "catalog:sources:import-species-backbone": "tsx scripts/import-species-backbone-seed.ts",
    "catalog:sources:import-breed-seed": "tsx scripts/import-breed-seed.ts",
    "catalog:sources:import-bg-official-variety": "tsx scripts/import-bg-official-variety.ts",
    "catalog:sources:import-eu-oj-common-catalogue": "tsx scripts/import-eu-oj-common-catalogue.ts",
    "catalog:sources:import-genebank-long-tail": "tsx scripts/import-genebank-long-tail.ts",
    "catalog:sources:seed-rollout-proof": "tsx scripts/seed-catalog-rollout-proof.ts",
    "catalog:sources:refresh-sample": "tsx scripts/refresh-catalog-source-sample.ts",
    "catalog:sources:verify": "tsx scripts/verify-catalog-sources.ts",
    "catalog:sources:dry-run": "tsx scripts/dry-run-catalog-full-import.ts",
    "catalog:sources:entity-resolution-qa": "tsx scripts/report-catalog-entity-resolution-qa.ts",
    "smoke:garden-catalog-ux": "tsx scripts/smoke-garden-catalog-ux.ts",
    "smoke:garden-eu-oj-common-catalogue": "tsx scripts/smoke-garden-eu-oj-common-catalogue.ts",
    "smoke:garden-bg-official-varieties": "tsx scripts/smoke-garden-bg-official-varieties.ts",
    "smoke:erasure-workflow": "NODE_OPTIONS=--conditions=react-server tsx scripts/smoke-erasure-workflow.ts",
    "mainline:closeout:check": "tsx scripts/check-mainline-closeout.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "local:bootstrap": "tsx scripts/bootstrap-local.ts",
    "pilot:invite": "tsx scripts/generate-pilot-invite.ts",
    "pilot:reset-password": "tsx scripts/generate-pilot-password-reset.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@base-ui/react": "^1.6.0",
    "better-auth": "^1.6.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "kysely": "^0.29.2",
    "lucide-react": "^1.21.0",
    "meilisearch": "0.58.0",
    "next": "16.2.9",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.11.0",
    "sharp": "^0.35.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "kysely-codegen": "^0.20.0",
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
