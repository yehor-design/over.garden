{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:3000",
          "https://over-garden.vercel.app",
          "https://over.garden",
          "https://www.over.garden"
        ],
        "methods": ["PUT", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
