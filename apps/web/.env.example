# OverGarden web app environment template.
# Copy to .env.local and fill real values. Never commit real secrets.

# App URL and auth. Local development can omit both secret entries and use the
# isolated local fallback. Production and Preview require the versioned pair:
# `BETTER_AUTH_SECRETS` holds ordered `version:secret` entries and
# `BETTER_AUTH_CURRENT_SECRET_VERSION` names the first entry. Keep the
# pre-versioned `BETTER_AUTH_SECRET` only while the bounded migration grace
# window is active. It must be an exact 32-byte standard Base64 or Base64url
# value and needs the strict UTC deadline below. An invalid or expired fallback
# is clean-cut from reads; never copy production values.
BETTER_AUTH_URL="http://localhost:3000"
PUBLIC_SITE_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""
BETTER_AUTH_SECRETS=""
BETTER_AUTH_CURRENT_SECRET_VERSION=""
BETTER_AUTH_LEGACY_GRACE_UNTIL=""
# Transactional auth email through Resend. RESEND_API_KEY is secret; keep real
# values in local/platform env stores only. Production auth links use
# https://over.garden.
RESEND_API_KEY=""
RESEND_AUTH_FROM="OverGarden <auth@over.garden>"
RESEND_AUTH_REPLY_TO=""
# Google OAuth web client. Authorized redirect URIs:
# - http://localhost:3000/api/auth/callback/google
# - https://over.garden/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Explicit account linking is independent from ordinary Google sign-in. Keep
# this absent/false until the Google uniqueness migration and live callback
# proof are authorized and completed by OVE-298.
GOOGLE_ACCOUNT_LINKING_ENABLED="false"
# Consent-first Meta Ads attribution. This surface does not provide sign-in.
# Keep the public flag false unless the Meta Pixel/Data Source and CAPI token
# are ready and the privacy smoke in docs/META_ADS_ATTRIBUTION_READINESS.md
# has passed. Pixel id is public; the CAPI access token is secret.
NEXT_PUBLIC_META_MARKETING_MEASUREMENT_ENABLED="false"
NEXT_PUBLIC_META_PIXEL_ID=""
META_CONVERSIONS_API_ACCESS_TOKEN=""
META_CONVERSIONS_API_TEST_EVENT_CODE=""
META_CONVERSIONS_API_GRAPH_VERSION="v23.0"

# Consent-first Microsoft Clarity UX observation. Project id is public, but keep
# this disabled until the Clarity project/settings, under-18 targeting check,
# analytics consent flow, and privacy smoke are ready.
NEXT_PUBLIC_MICROSOFT_CLARITY_ENABLED="false"
NEXT_PUBLIC_MICROSOFT_CLARITY_PROJECT_ID=""

# Postgres. Runtime should use a pooled app connection; migrations/codegen use
# the direct session connection. DigitalOcean Managed Postgres is the production
# target; local Apple Container scripts expose Postgres on localhost:5432.
# Docker Compose remains a documented fallback only.
DATABASE_URL="postgresql://overgarden:overgarden@localhost:5432/overgarden"
DIRECT_URL="postgresql://overgarden:overgarden@localhost:5432/overgarden"
DATABASE_POOL_MAX="10"
DATABASE_SSL="false"
# Deterministic OVE-187 visual fixtures. Keep disabled by default. The commands
# additionally reject Vercel Production, canonical OverGarden origins, a
# database-name mismatch, and non-loopback local databases before opening DB or
# object-storage clients. Preview writes require a separate explicit gate.
VISUAL_FIXTURES_ENABLED="false"
VISUAL_FIXTURES_TARGET="local"
VISUAL_FIXTURES_DATABASE="overgarden"
VISUAL_FIXTURES_ALLOW_PREVIEW="false"
# Local-only walking-skeleton diagnostic. The full local visual-fixture safety
# gate must also pass; production builds and Vercel deployments always refuse it.
WALKING_SKELETON_ENABLED="false"
# Optional private local credential for the OVE-161 --seed-ui browser fixture.
# Normal proof runs generate an ephemeral password and do not use this value.
OVE161_SMOKE_UI_PASSWORD=""
# Managed Postgres deployments can provide the CA certificate as one escaped
# line in Vercel, for example: DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n..."
# Deployment fallback aliases supported by the app runtime when DATABASE_URL is
# absent: POSTGRES_URL, POSTGRES_PRISMA_URL, or POSTGRES_HOST/POSTGRES_USER/
# POSTGRES_PASSWORD/POSTGRES_DATABASE. DIRECT_URL may fall back to
# POSTGRES_URL_NON_POOLING for smoke/readiness only.

# Cloudflare R2. Local development can point this at MinIO from infra/container-up.
# Docker Compose remains a documented fallback only.
# Production non-secret values and dashboard links are recorded in
# ../../docs/INFRASTRUCTURE_REGISTRY.md. Production should use:
# R2_ENDPOINT="https://cb03b15042adc74edfe2d8201636300a.r2.cloudflarestorage.com"
# R2_FORCE_PATH_STYLE="true"
# R2_QUARANTINE_BUCKET="overgarden-quarantine"
# R2_PUBLIC_BUCKET="overgarden-public"
# R2_PUBLIC_BASE_URL="https://media.over.garden"
R2_ENDPOINT="http://localhost:9000"
R2_ACCESS_KEY_ID="overgarden"
R2_SECRET_ACCESS_KEY="overgarden-local-secret"
R2_FORCE_PATH_STYLE="true"
R2_QUARANTINE_BUCKET="overgarden-quarantine"
R2_PUBLIC_BUCKET="overgarden-public"
R2_PUBLIC_BASE_URL="http://localhost:9000/overgarden-public"

# ADR-0019 ephemeral final-WebP staging. The base URL and current versions are
# non-secret; each ordered `version:secret` set and the commit-status key are
# server-only secrets shared only by the named Vercel/Worker boundary. Never
# add a NEXT_PUBLIC alias or copy production material into this file.
EPHEMERAL_MEDIA_STAGING_BASE_URL="https://media-stage.over.garden"
EPHEMERAL_MEDIA_CAPABILITY_SECRETS=""
EPHEMERAL_MEDIA_CAPABILITY_CURRENT_VERSION="1"
EPHEMERAL_MEDIA_RECEIPT_SECRETS=""
EPHEMERAL_MEDIA_RECEIPT_CURRENT_VERSION="1"
EPHEMERAL_MEDIA_COMMIT_STATUS_SECRET=""

# Media lifecycle (OVE-195). Local MinIO can omit Cloudflare purge credentials.
# Production Vercel must set both purge vars so revoked derivatives stop serving
# through the CDN edge. CRON_SECRET protects POST /api/cron/media-lifecycle.
# CLOUDFLARE_ZONE_ID=""
# CLOUDFLARE_CACHE_PURGE_API_TOKEN=""
# CRON_SECRET=""

# Meilisearch derived index.
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="CHANGE_ME_to_a_32+_byte_secret"

# Internal operator gate. Comma-separated Better Auth user IDs.
# If empty, catalog curation and erasure review deny access.
CATALOG_CURATOR_USER_IDS=""

# Python matching/worker tier. The product request path does not depend on it.
MATCHING_SERVICE_URL="http://localhost:8000"
MATCHING_SERVICE_TOKEN="CHANGE_ME_shared_service_token"

# EPPO Global Database API v2. The value is a server-only source-ingestion
# credential; never add a NEXT_PUBLIC alias or commit a real value. Use the
# masked bootstrap command after main containment to place Production only.
EPPO_DATA_PORTAL_API_KEY=""
