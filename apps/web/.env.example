# OverGarden — web app (apps/web) environment template.
# Copy to `.env.local` and fill in real values. NEVER commit real secrets.
# Supabase / Vercel / Railway are wired later; the app boots without these
# (DB/auth calls are guarded), but most seams stay inert until they are set.

# ── Supabase Postgres (Drizzle) ──────────────────────────────────────────────
# Runtime: Supavisor TRANSACTION-mode pooler (port 6543). The client forces
# { prepare: false } — required for transaction mode.
DATABASE_URL="postgres://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres"
# Migrations ONLY: DIRECT connection (port 5432). Used by drizzle-kit (migrate).
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# ── Supabase Auth / Storage ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# Browser-safe publishable key (replaces the legacy anon key). Respects RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
# Server-only secret key (replaces legacy service_role). BYPASSES RLS.
# NEVER prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SECRET_KEY="sb_secret_xxx"

# ── Meilisearch (self-hosted on Railway) ─────────────────────────────────────
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="<meili-search-key>"

# ── Python matching service (Railway) ────────────────────────────────────────
MATCHING_SERVICE_URL="http://localhost:8000"
# Shared secret for Next (Vercel) -> Python (Railway) service-to-service calls.
MATCHING_SERVICE_TOKEN="<shared-service-token>"
