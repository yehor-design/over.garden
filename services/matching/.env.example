# OverGarden matching tier environment template. Copy to .env and fill real values.
# Never commit real secrets.

# Worker -> Postgres direct/session connection. Production target is DigitalOcean
# Managed Postgres; supported local Mac development should use infra/container-up.
DIRECT_URL="postgresql://overgarden:overgarden@localhost:5432/overgarden"

QUEUE_NAME="matching"
WORKER_ID="matching-worker-local"
WORKER_POLL_SECONDS="1.0"
WORKER_VT_SECONDS="30"

MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="CHANGE_ME_to_a_32+_byte_secret"

MATCHING_SERVICE_TOKEN="CHANGE_ME_shared_service_token"
