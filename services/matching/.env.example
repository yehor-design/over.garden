# OverGarden — matching tier (services/matching) environment template.
# Copy to `.env` and fill in real values. NEVER commit real secrets.

# Worker -> Postgres DIRECT connection (psycopg). The worker is long-lived, so
# use the DIRECT / session connection (port 5432), NOT the transaction-mode
# pooler. Named DIRECT_URL (not DATABASE_URL) to mirror the web app and avoid
# accidentally giving the worker a pooler URL.
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# pgmq queue the worker consumes (matches the TS producer's queue name).
QUEUE_NAME="jobs"
WORKER_POLL_SECONDS="1.0"
WORKER_VT_SECONDS="30"

# Meilisearch (self-hosted on Railway).
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="<meili-master-or-admin-key>"

# Shared secret for Next (Vercel) -> Python (Railway) service-to-service auth.
MATCHING_SERVICE_TOKEN="<shared-service-token>"
