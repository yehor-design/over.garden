#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/container-common"

MODE=""
SOURCE_VOLUME=""
TARGET_VOLUME=""
CONFIRMATION=""
RECOVERY_HELPER_IMAGE="${OVERGARDEN_RECOVERY_HELPER_IMAGE:-docker.io/library/alpine:3.22}"
RECOVERY_VERIFY_PORT="${OVERGARDEN_RECOVERY_VERIFY_PORT:-19000}"
RECOVERY_VERIFY_CONSOLE_PORT="${OVERGARDEN_RECOVERY_VERIFY_CONSOLE_PORT:-19001}"
RECOVERY_TEMP_CONTAINER="overgarden-minio-recovery-verify-$$"

usage() {
  cat <<'USAGE'
Usage:
  infra/container-recover-minio --plan [--source <exact-volume>] [--target <exact-new-volume>]
  infra/container-recover-minio --execute --source <exact-volume> --target <exact-new-volume> \
    --confirm "PRESERVE <source> AND RECOVER INTO <target>"

The plan mounts the exact source read-only through an ephemeral helper and emits
only bounded counts and health classes. Execute creates one new target volume,
copies every readable user-bucket file while excluding rebuildable MinIO system
state, verifies the copy and isolated MinIO readiness, then records the target as
the local active volume. It never deletes, overwrites, repairs, or retires the
source volume.
USAGE
}

while (( $# > 0 )); do
  case "$1" in
    --plan)
      [[ -z "$MODE" ]] || fail "Choose exactly one mode: --plan or --execute."
      MODE="plan"
      shift
      ;;
    --execute)
      [[ -z "$MODE" ]] || fail "Choose exactly one mode: --plan or --execute."
      MODE="execute"
      shift
      ;;
    --source)
      [[ $# -ge 2 ]] || fail "--source requires one exact volume identifier."
      SOURCE_VOLUME="$2"
      shift 2
      ;;
    --target)
      [[ $# -ge 2 ]] || fail "--target requires one exact volume identifier."
      TARGET_VOLUME="$2"
      shift 2
      ;;
    --confirm)
      [[ $# -ge 2 ]] || fail "--confirm requires the exact recovery phrase."
      CONFIRMATION="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      fail "Unknown argument: $1"
      ;;
  esac
done

[[ -n "$MODE" ]] || fail "Choose exactly one mode: --plan or --execute."

if [[ -z "$SOURCE_VOLUME" ]]; then
  [[ "$MODE" == "plan" ]] || fail "Execute mode requires an explicit --source."
  SOURCE_VOLUME="$MINIO_VOLUME"
fi

require_valid_container_identifier "Source MinIO volume" "$SOURCE_VOLUME"
if [[ -n "$TARGET_VOLUME" ]]; then
  require_valid_container_identifier "Target MinIO volume" "$TARGET_VOLUME"
  [[ "$SOURCE_VOLUME" != "$TARGET_VOLUME" ]] || fail "Source and target volumes must be different exact identifiers."
fi

require_container_cli
require_curl
load_env
container system status >/dev/null 2>&1 ||
  fail "Apple Container system must already be running. The recovery plan will not start it implicitly."

inventory_volume() {
  local volume="$1"
  local helper="overgarden-minio-inventory-$$-$RANDOM"

  container run --rm --progress none \
    --name "$helper" \
    --mount "type=volume,source=$volume,target=/source,readonly" \
    "$RECOVERY_HELPER_IMAGE" sh -c '
      set +e
      bucket_errors=/tmp/bucket-errors
      system_errors=/tmp/system-errors
      : > "$bucket_errors"
      : > "$system_errors"
      bucket_count=0
      bucket_file_count=0
      object_metadata_count=0

      for entry in /source/* /source/.[!.]* /source/..?*; do
        [ -e "$entry" ] || continue
        base=${entry##*/}
        [ "$base" = ".minio.sys" ] && continue
        [ "$base" = "lost+found" ] && continue
        [ -d "$entry" ] || continue
        bucket_count=$((bucket_count + 1))
        files=$(find "$entry" -xdev -type f 2>>"$bucket_errors" | wc -l | tr -d " ")
        metadata=$(find "$entry" -xdev -type f -name "xl.meta" 2>>"$bucket_errors" | wc -l | tr -d " ")
        bucket_file_count=$((bucket_file_count + files))
        object_metadata_count=$((object_metadata_count + metadata))
      done

      if [ -d /source/.minio.sys ]; then
        find /source/.minio.sys -xdev -type f >/dev/null 2>"$system_errors"
      fi

      bucket_error_count=$(wc -l < "$bucket_errors" | tr -d " ")
      system_error_count=$(wc -l < "$system_errors" | tr -d " ")
      printf "%s %s %s %s %s\n" "$bucket_count" "$bucket_file_count" "$object_metadata_count" "$bucket_error_count" "$system_error_count"
      if [ "$bucket_error_count" -gt 0 ]; then exit 2; fi
    '
}

copy_bucket_data() {
  local source="$1"
  local target="$2"
  local helper="overgarden-minio-copy-$$-$RANDOM"

  container run --rm --progress none \
    --name "$helper" \
    --mount "type=volume,source=$source,target=/source,readonly" \
    --mount "type=volume,source=$target,target=/target" \
    "$RECOVERY_HELPER_IMAGE" sh -c '
      set -eu
      set -o pipefail
      errors=/tmp/copy-errors
      differences=/tmp/copy-differences
      : > "$errors"
      : > "$differences"

      if ! (cd /source && tar --exclude="./.minio.sys" --exclude="./lost+found" -cf - . 2>>"$errors") |
        (cd /target && tar -xpf - 2>>"$errors"); then
        printf "copy_class=partial\n"
        exit 2
      fi

      for entry in /source/* /source/.[!.]* /source/..?*; do
        [ -e "$entry" ] || continue
        base=${entry##*/}
        [ "$base" = ".minio.sys" ] && continue
        [ "$base" = "lost+found" ] && continue
        if ! diff -qr "$entry" "/target/$base" >>"$differences" 2>&1; then
          printf "copy_class=mismatch\n"
          exit 3
        fi
      done

      printf "copy_class=complete\n"
    '
}

minio_like_candidate_count() {
  container volume list 2>/dev/null |
    awk -v source="$SOURCE_VOLUME" '
      NR > 1 && tolower($1) ~ /minio/ && $1 != source { count += 1 }
      END { print count + 0 }
    '
}

source_runtime_class() {
  if container_exists "$MINIO_CONTAINER" &&
    container_has_volume "$MINIO_CONTAINER" "$SOURCE_VOLUME"; then
    minio_failure_class
  else
    printf 'not-canonically-mounted\n'
  fi
}

capture_source_inventory() {
  local output
  local status

  if output="$(inventory_volume "$SOURCE_VOLUME")"; then
    status=0
  else
    status=$?
  fi

  read -r SOURCE_BUCKET_COUNT SOURCE_FILE_COUNT SOURCE_OBJECT_METADATA_COUNT SOURCE_BUCKET_ERROR_COUNT SOURCE_SYSTEM_ERROR_COUNT <<<"$output"
  [[ -n "${SOURCE_BUCKET_COUNT:-}" ]] || fail "Source inventory did not return a bounded result."

  if (( status == 0 )); then
    SOURCE_INVENTORY_CLASS="complete"
  elif (( status == 2 )); then
    SOURCE_INVENTORY_CLASS="partial"
  else
    SOURCE_INVENTORY_CLASS="unreadable"
  fi
}

print_plan() {
  local target_state="not-specified"
  local target_resolution="not-specified"
  local candidate_count
  local source_references
  local source_running_references
  local runtime_class
  local canonical_minio_state="absent"
  local preserved_source_record="absent"
  local recorded_source

  volume_exists "$SOURCE_VOLUME" || fail "Exact source volume $SOURCE_VOLUME does not exist."
  source_references="$(container_reference_count_for_volume "$SOURCE_VOLUME")"
  source_running_references="$(running_container_reference_count_for_volume "$SOURCE_VOLUME")"
  runtime_class="$(source_runtime_class)"
  if container_exists "$MINIO_CONTAINER"; then
    if container_running "$MINIO_CONTAINER"; then
      canonical_minio_state="running"
    else
      canonical_minio_state="stopped"
    fi
  fi
  candidate_count="$(minio_like_candidate_count)"
  if [[ -f "$MINIO_PRESERVED_SOURCE_FILE" ]]; then
    recorded_source="$(sed -n '1p' "$MINIO_PRESERVED_SOURCE_FILE")"
    require_valid_container_identifier "Recorded preserved MinIO source" "$recorded_source"
    if [[ "$recorded_source" == "$SOURCE_VOLUME" ]]; then
      preserved_source_record="matching"
    else
      preserved_source_record="conflict"
    fi
  fi
  capture_source_inventory

  if [[ -n "$TARGET_VOLUME" ]]; then
    if volume_exists "$TARGET_VOLUME"; then
      target_state="present"
      target_resolution="unsafe-existing"
    else
      target_state="absent"
      target_resolution="exact-new"
    fi
  elif (( candidate_count > 1 )); then
    target_resolution="ambiguous"
  fi

  info "mode=plan"
  info "source_volume=$SOURCE_VOLUME"
  info "source_state=present"
  info "source_reference_count=$source_references"
  info "source_running_reference_count=$source_running_references"
  info "source_runtime_class=$runtime_class"
  info "canonical_minio_state=$canonical_minio_state"
  info "preserved_source_record=$preserved_source_record"
  info "source_inventory_class=$SOURCE_INVENTORY_CLASS"
  info "source_bucket_count=$SOURCE_BUCKET_COUNT"
  info "source_file_count=$SOURCE_FILE_COUNT"
  info "source_object_metadata_count=$SOURCE_OBJECT_METADATA_COUNT"
  info "source_bucket_traversal_errors=$SOURCE_BUCKET_ERROR_COUNT"
  info "source_system_traversal_errors=$SOURCE_SYSTEM_ERROR_COUNT"
  info "target_volume=${TARGET_VOLUME:-not-specified}"
  info "target_state=$target_state"
  info "target_candidate_count=$candidate_count"
  info "target_resolution=$target_resolution"
  info "source_mutation=none"
  info "source_retirement=not-authorized"

  [[ "$SOURCE_INVENTORY_CLASS" == "complete" ]] || return 2
  (( source_running_references == 0 )) || return 2
  (( source_references <= 1 )) || return 2
  [[ "$canonical_minio_state" != "running" ]] || return 2
  [[ "$preserved_source_record" != "conflict" ]] || return 2
  if [[ -n "$TARGET_VOLUME" ]]; then
    [[ "$target_resolution" == "exact-new" ]] || return 2
  elif [[ "$target_resolution" == "ambiguous" ]]; then
    return 2
  fi
}

cleanup_temp_container() {
  if container_running "$RECOVERY_TEMP_CONTAINER"; then
    container stop "$RECOVERY_TEMP_CONTAINER" >/dev/null 2>&1 || true
  fi
  if container_exists "$RECOVERY_TEMP_CONTAINER"; then
    container delete "$RECOVERY_TEMP_CONTAINER" >/dev/null 2>&1 || true
  fi
}

verify_target_readiness() {
  port_open "$RECOVERY_VERIFY_PORT" &&
    fail "Recovery verification port $RECOVERY_VERIFY_PORT is already in use."
  port_open "$RECOVERY_VERIFY_CONSOLE_PORT" &&
    fail "Recovery verification console port $RECOVERY_VERIFY_CONSOLE_PORT is already in use."
  container_exists "$RECOVERY_TEMP_CONTAINER" &&
    fail "Exact recovery verification container already exists: $RECOVERY_TEMP_CONTAINER"

  trap cleanup_temp_container EXIT
  container run --detach --progress none \
    --name "$RECOVERY_TEMP_CONTAINER" \
    --publish "127.0.0.1:$RECOVERY_VERIFY_PORT:9000" \
    --publish "127.0.0.1:$RECOVERY_VERIFY_CONSOLE_PORT:9001" \
    --env "MINIO_ROOT_USER=$MINIO_ROOT_USER" \
    --env "MINIO_ROOT_PASSWORD=$MINIO_ROOT_PASSWORD" \
    --volume "$TARGET_VOLUME:/data" \
    "$MINIO_IMAGE" server /data --console-address ":9001" >/dev/null

  local deadline=$((SECONDS + 60))
  until curl -fsS "http://127.0.0.1:$RECOVERY_VERIFY_PORT/minio/health/ready" >/dev/null; do
    if ! container_running "$RECOVERY_TEMP_CONTAINER"; then
      fail "Recovered target MinIO stopped before isolated readiness. Source and target volumes remain preserved."
    fi
    if (( SECONDS >= deadline )); then
      fail "Recovered target MinIO did not reach isolated readiness. Source and target volumes remain preserved."
    fi
    sleep 2
  done

  cleanup_temp_container
  trap - EXIT
}

record_activation() {
  local pointer_tmp
  local source_tmp

  mkdir -p "$INFRA_RUNTIME_STATE_DIR"
  chmod 700 "$INFRA_RUNTIME_STATE_DIR"
  umask 077

  if [[ -f "$MINIO_PRESERVED_SOURCE_FILE" ]]; then
    local existing_source
    existing_source="$(sed -n '1p' "$MINIO_PRESERVED_SOURCE_FILE")"
    [[ "$existing_source" == "$SOURCE_VOLUME" ]] ||
      fail "A different preserved MinIO source is already recorded; refusing to overwrite recovery state."
  fi

  pointer_tmp="$MINIO_VOLUME_STATE_FILE.tmp.$$"
  source_tmp="$MINIO_PRESERVED_SOURCE_FILE.tmp.$$"
  printf '%s\n' "$TARGET_VOLUME" >"$pointer_tmp"
  printf '%s\n' "$SOURCE_VOLUME" >"$source_tmp"
  mv "$source_tmp" "$MINIO_PRESERVED_SOURCE_FILE"
  mv "$pointer_tmp" "$MINIO_VOLUME_STATE_FILE"
}

if [[ "$MODE" == "plan" ]]; then
  print_plan
  exit $?
fi

[[ -n "$TARGET_VOLUME" ]] || fail "Execute mode requires an explicit --target."
expected_confirmation="PRESERVE $SOURCE_VOLUME AND RECOVER INTO $TARGET_VOLUME"
[[ "$CONFIRMATION" == "$expected_confirmation" ]] ||
  fail "Confirmation mismatch. Use exactly: $expected_confirmation"

set +e
print_plan
plan_status=$?
set -e
(( plan_status == 0 )) || fail "Recovery preflight did not pass; no target volume was created."
[[ "$SOURCE_INVENTORY_CLASS" == "complete" ]] ||
  fail "Source user-bucket inventory is not complete; recovery requires a bounded loss decision before execution."

info "mode=execute"
info "source_volume=$SOURCE_VOLUME"
info "target_volume=$TARGET_VOLUME"
info "source_mount=readonly"
info "source_retirement=not-authorized"

container volume create "$TARGET_VOLUME" >/dev/null

if copy_result="$(copy_bucket_data "$SOURCE_VOLUME" "$TARGET_VOLUME")"; then
  copy_status=0
else
  copy_status=$?
fi
if (( copy_status != 0 )) || [[ "$copy_result" != "copy_class=complete" ]]; then
  case "$copy_result" in
    copy_class=partial|copy_class=mismatch) copy_failure_class="$copy_result" ;;
    *) copy_failure_class="copy_class=unreadable" ;;
  esac
  fail "Recovery copy failed with bounded $copy_failure_class. Source and failed target remain preserved for investigation."
fi

set +e
target_inventory_output="$(inventory_volume "$TARGET_VOLUME")"
target_inventory_status=$?
set -e
read -r TARGET_BUCKET_COUNT TARGET_FILE_COUNT TARGET_OBJECT_METADATA_COUNT TARGET_BUCKET_ERROR_COUNT TARGET_SYSTEM_ERROR_COUNT <<<"$target_inventory_output"

(( target_inventory_status == 0 )) ||
  fail "Recovered target inventory is incomplete. Source and failed target remain preserved for investigation."
[[ "$SOURCE_BUCKET_COUNT" == "$TARGET_BUCKET_COUNT" ]] &&
  [[ "$SOURCE_FILE_COUNT" == "$TARGET_FILE_COUNT" ]] &&
  [[ "$SOURCE_OBJECT_METADATA_COUNT" == "$TARGET_OBJECT_METADATA_COUNT" ]] ||
  fail "Recovered target counts do not match the complete source inventory. Source and failed target remain preserved."

verify_target_readiness
record_activation

info "copy_class=complete"
info "inventory_comparison=match"
info "target_minio_readiness=ready"
info "active_volume_recorded=$TARGET_VOLUME"
info "source_preserved=yes"
info "next_action=infra/container-up --recreate"
