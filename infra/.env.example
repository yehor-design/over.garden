# Local infra env template. Apple Container scripts read this first; Docker Compose
# can still use it as a fallback. Copy to infra/.env to override local defaults.
POSTGRES_DB="overgarden"
POSTGRES_USER="overgarden"
POSTGRES_PASSWORD="overgarden"

# Generate a strong key, e.g. `openssl rand -base64 48`.
MEILI_MASTER_KEY="CHANGE_ME_to_a_32+_byte_secret"

MINIO_ROOT_USER="overgarden"
MINIO_ROOT_PASSWORD="overgarden-local-secret"
