#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${OVERGARDEN_INFRA_ENV_FILE:-$SCRIPT_DIR/.env}"
EXAMPLE_ENV_FILE="$SCRIPT_DIR/.env.example"

POSTGRES_CONTAINER="overgarden-postgres"
MEILI_CONTAINER="overgarden-meilisearch"
MINIO_CONTAINER="overgarden-minio"

POSTGRES_MAJOR="${OVERGARDEN_POSTGRES_MAJOR:-18}"
POSTGRES_VOLUME="${OVERGARDEN_POSTGRES_VOLUME:-overgarden-postgres-${POSTGRES_MAJOR}-data}"
MEILI_VOLUME="overgarden-meili-data"
MINIO_DEFAULT_VOLUME="overgarden-minio-data"
INFRA_RUNTIME_STATE_DIR="${OVERGARDEN_INFRA_STATE_DIR:-$SCRIPT_DIR/.runtime}"
MINIO_VOLUME_STATE_FILE="$INFRA_RUNTIME_STATE_DIR/minio-volume"
MINIO_PRESERVED_SOURCE_FILE="$INFRA_RUNTIME_STATE_DIR/minio-preserved-source"

if [[ -n "${OVERGARDEN_MINIO_VOLUME:-}" ]]; then
  MINIO_VOLUME="$OVERGARDEN_MINIO_VOLUME"
elif [[ -f "$MINIO_VOLUME_STATE_FILE" ]]; then
  MINIO_VOLUME="$(sed -n '1p' "$MINIO_VOLUME_STATE_FILE")"
else
  MINIO_VOLUME="$MINIO_DEFAULT_VOLUME"
fi

POSTGRES_IMAGE="${OVERGARDEN_POSTGRES_IMAGE:-docker.io/library/postgres:${POSTGRES_MAJOR}-alpine}"
MEILI_IMAGE="${OVERGARDEN_MEILI_IMAGE:-docker.io/getmeili/meilisearch:v1.48.1}"
MINIO_IMAGE="${OVERGARDEN_MINIO_IMAGE:-docker.io/minio/minio:latest}"

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

info() {
  printf '%s\n' "$*"
}

valid_container_identifier() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$ ]]
}

require_valid_container_identifier() {
  local label="$1"
  local value="$2"

  valid_container_identifier "$value" ||
    fail "$label must be one exact container identifier using only letters, numbers, dot, underscore, or hyphen."
}

require_valid_container_identifier "Active MinIO volume" "$MINIO_VOLUME"

refuse_preserved_minio_source_activation() {
  [[ -f "$MINIO_PRESERVED_SOURCE_FILE" ]] || return 0

  local preserved_source
  preserved_source="$(sed -n '1p' "$MINIO_PRESERVED_SOURCE_FILE")"
  require_valid_container_identifier "Preserved MinIO recovery source" "$preserved_source"
  [[ "$MINIO_VOLUME" != "$preserved_source" ]] ||
    fail "Refusing to activate preserved MinIO recovery source $preserved_source. Recovery sources are read-only forensic inputs; use the recorded recovered target or obtain a separate exact-target retirement decision. No containers or volumes were changed."
}

require_container_cli() {
  command -v container >/dev/null 2>&1 || fail "Apple Container CLI is not installed or not on PATH. Install Apple Container first, then rerun this command."
}

require_curl() {
  command -v curl >/dev/null 2>&1 || fail "curl is required for Meilisearch and MinIO readiness checks."
}

load_env() {
  local source_file="$ENV_FILE"

  if [[ ! -f "$source_file" ]]; then
    source_file="$EXAMPLE_ENV_FILE"
    info "Using infra/.env.example defaults. Create infra/.env to override local credentials."
  fi

  [[ -f "$source_file" ]] || fail "Missing infra env file. Expected $ENV_FILE or $EXAMPLE_ENV_FILE."

  set -a
  # shellcheck disable=SC1090
  source "$source_file"
  set +a

  : "${POSTGRES_DB:=overgarden}"
  : "${POSTGRES_USER:=overgarden}"
  : "${POSTGRES_PASSWORD:=overgarden}"
  : "${MEILI_MASTER_KEY:=CHANGE_ME_to_a_32+_byte_secret}"
  : "${MINIO_ROOT_USER:=overgarden}"
  : "${MINIO_ROOT_PASSWORD:=overgarden-local-secret}"

  if (( ${#MEILI_MASTER_KEY} < 16 )); then
    fail "MEILI_MASTER_KEY must be at least 16 bytes. Set it in infra/.env."
  fi
}

ensure_container_system() {
  if container system status >/dev/null 2>&1; then
    return 0
  fi

  info "Apple Container system is not running; starting it now."
  container system start --enable-kernel-install --timeout 120
}

container_exists() {
  container inspect "$1" >/dev/null 2>&1
}

container_running() {
  container inspect "$1" 2>/dev/null | grep -Eq '"state"[[:space:]]*:[[:space:]]*"running"|"status"[[:space:]]*:[[:space:]]*"running"'
}

container_inspect_normalized() {
  container inspect "$1" 2>/dev/null | sed 's#\\/#/#g'
}

container_image_reference() {
  container_inspect_normalized "$1" | awk -F'"' '/"reference"[[:space:]]*:/ { print $4; exit }'
}

container_image_matches() {
  local name="$1"
  local image="$2"

  container_inspect_normalized "$name" | grep -F "\"reference\" : \"$image\"" >/dev/null
}

container_has_volume() {
  local name="$1"
  local volume="$2"

  container_inspect_normalized "$name" | grep -F "\"name\" : \"$volume\"" >/dev/null
}

container_reference_count_for_volume() {
  local volume="$1"
  local count=0
  local name

  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    if container_has_volume "$name" "$volume"; then
      count=$((count + 1))
    fi
  done < <(container list --all --quiet 2>/dev/null || true)

  printf '%s\n' "$count"
}

running_container_reference_count_for_volume() {
  local volume="$1"
  local count=0
  local name

  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    if container_running "$name" && container_has_volume "$name" "$volume"; then
      count=$((count + 1))
    fi
  done < <(container list --all --quiet 2>/dev/null || true)

  printf '%s\n' "$count"
}

volume_exists() {
  container volume inspect "$1" >/dev/null 2>&1
}

ensure_volume() {
  local volume="$1"

  if volume_exists "$volume"; then
    info "Volume exists: $volume"
  else
    info "Creating volume: $volume"
    container volume create "$volume" >/dev/null
  fi
}

port_open() {
  local port="$1"

  if command -v nc >/dev/null 2>&1; then
    nc -z 127.0.0.1 "$port" >/dev/null 2>&1
  else
    : >"/dev/tcp/127.0.0.1/$port" 2>/dev/null
  fi
}

postgres_ready() {
  container_running "$POSTGRES_CONTAINER" &&
    container exec "$POSTGRES_CONTAINER" pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB" >/dev/null 2>&1 &&
    port_open 5432
}

meili_ready() {
  container_running "$MEILI_CONTAINER" &&
    curl -fsS http://127.0.0.1:7700/health >/dev/null
}

minio_ready() {
  container_running "$MINIO_CONTAINER" &&
    container_has_volume "$MINIO_CONTAINER" "$MINIO_VOLUME" &&
    curl -fsS http://127.0.0.1:9000/minio/health/ready >/dev/null
}

minio_failure_class() {
  if minio_ready; then
    printf 'ready\n'
    return 0
  fi

  if ! container_exists "$MINIO_CONTAINER"; then
    printf 'absent\n'
    return 0
  fi

  if container_running "$MINIO_CONTAINER" &&
    ! container_has_volume "$MINIO_CONTAINER" "$MINIO_VOLUME"; then
    printf 'contract-mismatch\n'
    return 0
  fi

  if container logs -n 200 "$MINIO_CONTAINER" 2>/dev/null | grep -Eqi \
    'structure needs cleaning|drive may be faulty|drive not found|input/output error'; then
    printf 'corrupt-volume\n'
    return 0
  fi

  if container_running "$MINIO_CONTAINER"; then
    printf 'not-ready\n'
  else
    printf 'stopped-unknown\n'
  fi
}

wait_for_minio() {
  local timeout_seconds="$1"
  local deadline=$((SECONDS + timeout_seconds))
  local failure_class

  until minio_ready; do
    failure_class="$(minio_failure_class)"
    if [[ "$failure_class" == "corrupt-volume" ]]; then
      fail "MinIO corrupt-volume class detected for exact volume $MINIO_VOLUME. Run $SCRIPT_DIR/container-recover-minio --plan --source $MINIO_VOLUME with an explicit new target."
    fi
    if [[ "$failure_class" == "stopped-unknown" ]]; then
      fail "MinIO stopped before readiness for exact volume $MINIO_VOLUME. Run $SCRIPT_DIR/container-status for the bounded failure class."
    fi
    if (( SECONDS >= deadline )); then
      fail "MinIO did not become ready within ${timeout_seconds}s for exact volume $MINIO_VOLUME."
    fi
    sleep 2
  done

  info "MinIO is ready."
}

wait_for() {
  local label="$1"
  local timeout_seconds="$2"
  local check_name="$3"
  local deadline=$((SECONDS + timeout_seconds))

  until "$check_name"; do
    if (( SECONDS >= deadline )); then
      fail "$label did not become ready within ${timeout_seconds}s."
    fi
    sleep 2
  done

  info "$label is ready."
}
